# Create a bot at https://discord.com/developers/applications and copy its token.
DISCORD_TOKEN=replace-with-your-bot-token

# Optional: register commands instantly in one development server.
# Without this, commands are registered globally and may take time to appear.
DEV_GUILD_ID=

# Initial playback volume for new queues (1-100).
DEFAULT_VOLUME=80

# Persisted per-server settings are stored here.
DATA_FILE=./data/guilds.json
